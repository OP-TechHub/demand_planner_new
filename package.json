{
  "name": "oceanpick-demand-planner",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:link": "supabase link --project-ref",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked --schema demand_planner > packages/shared/src/database.types.ts"
  },
  "devDependencies": {
    "supabase": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
